# Redis (Notion: consumer-inference 페이지 참고)
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# MySQL RDS (공연 테이블 security_level 조회)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# AI 모듈 내부 주소
VQA_IMAGE_URL=http://localhost:8002
VQA_ILLUSION_URL=http://localhost:8001
MOUSE_QUIZ_URL=http://localhost:8003

# 보안 레벨 정책 (env 수정만으로 모듈 배정 변경 가능)
POLICY_LOW=mouse-quiz
POLICY_MEDIUM=mouse-quiz,vqa-image
POLICY_HIGH=mouse-quiz,vqa-illusion

# 동시 챌린지 수 상한 (백엔드 대기열이 1차 제어하므로 보조 수단)
MAX_CONCURRENT_PER_PERF=500
