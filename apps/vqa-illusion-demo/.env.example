# =============================================================
# VQA Illusion Demo — 서빙 모듈 환경변수
# 오프라인 파이프라인(이미지 생성, 문제 생성)은 .env.pipeline.example 참고
# =============================================================

# --- DB (둘 중 하나만 설정) ---

# Supabase (개발/현재)
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_KEY=eyJ...

# AWS RDS MySQL (프로덕션)
# DB_BACKEND=rds
# DATABASE_URL=mysql+pymysql://user:pass@rds-host:3306/vqa

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# --- Server ---
VQA_ILLUSION_BASE_URL=http://localhost:8001
