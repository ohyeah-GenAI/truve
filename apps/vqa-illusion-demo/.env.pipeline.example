# =============================================================
# VQA Illusion Demo — 오프라인 파이프라인 환경변수
# scripts/ 폴더의 이미지 생성, 문제 생성 스크립트 실행 시 사용
# 서빙 모듈(Docker)에는 불필요 → .env.example 참고
# =============================================================

# Task 1: Base image generation backend
# replicate (default) or hf
BASE_IMAGE_BACKEND=replicate

# Replicate (default backend)
REPLICATE_API_TOKEN=r8_...

# HuggingFace Inference API (fallback)
# HF_API_KEY=hf_...

# Task 1.5: LLM prompt enrichment (enrich_catalog.py)
# openai (default) or claude
PROMPT_BACKEND=openai
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Task 2: Illusion image generation
# ILLUSION_BACKEND=hf   (기본값, 현재 hf만 지원)
# HF_API_KEY=           (동일 키 재사용 — HF Space rate limit 완화)
# ILLUSION_HF_SPACE=ChangWook2025/IllusionDiffusion  # Space 복제 시 주석 해제 (기본: AP123/IllusionDiffusion)

# Storage (파이프라인 결과물 업로드용)
# STORAGE_BACKEND=supabase   # 또는 s3

# Supabase Storage (현재 사용)
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_KEY=eyJ...

# S3 (프로덕션 전환 시 STORAGE_BACKEND=s3 으로 변경)
# S3_BUCKET_NAME=vqa-illusion
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# AWS_REGION=ap-northeast-2
